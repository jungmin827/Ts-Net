# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 프리뷰 하네스 산출물 — 어드민/후기 컴포넌트를 가짜 데이터로 서버 렌더한 임시 HTML.
# dev 서버가 정적 파일로 집어 주도록 public/ 아래에 두지만 커밋·배포 대상은 아니다.
# `npm run build` 는 prebuild 에서 이 디렉터리를 지우고 시작한다.
/public/_preview/
