# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 암호화 — 분실 시 기존 DB의 전화번호 복구 불가. 오프라인 백업 필수
ENCRYPTION_KEY=
PHONE_PEPPER=

# 봇 방지
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 트래킹
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_KAKAO_PIXEL_ID=
NEXT_PUBLIC_NAVER_ID=

# 사이트
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_TEL=

# 검색엔진 소유 확인 — 서치콘솔·네이버 서치어드바이저가 발급하는 메타 태그 content 값
GOOGLE_SITE_VERIFICATION=
NAVER_SITE_VERIFICATION=

# 개발 편의 — 어드민 2단계 인증 생략. `1` 일 때만, 그리고 NODE_ENV!=production 일 때만 동작.
# **운영 환경변수에 넣지 말 것.** 넣어도 무시되지만, 넣었다는 사실 자체가 혼란을 만든다.
ADMIN_SKIP_2FA=
